# Resend Email API
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM_EMAIL=SendFlowers <onboarding@resend.dev>

# App Config
HOST=0.0.0.0
PORT=5000
FRONTEND_URL=http://localhost:5173
ROSE_PRICE_INR=100

# Razorpay
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret

# Supabase (optional)
SUPABASE_URL=
SUPABASE_KEY=

# Legacy SMTP (optional fallback)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=SendFlowers
SMTP_USE_TLS=true

